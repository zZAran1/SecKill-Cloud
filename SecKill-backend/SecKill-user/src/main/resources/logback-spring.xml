<?xml version="1.0" encoding="UTF-8" ?>
<configuration>
    <property name="LOG_DIR" value="logs"/>
    <!-- 自定义 pattern 不会被 logging.pattern.correlation 影响，traceId/spanId 手动加入，用于跨服务串联请求 -->
    <property name="PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-},%X{spanId:-}] %logger{36} - %msg%n"/>

    <appender name ="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>${PATTERN}</pattern></encoder>
    </appender>

    <appender name = "FILE" class = "ch.qos.logback.core.rolling.RollingFileAppender">
        <file> ${LOG_DIR}/seckill-user.log </file>
        <rollingPolicy class = "ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/seckill-user.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>${PATTERN}</pattern></encoder>
    </appender>
    <springProfile name = "dev">
        <root level = "DEBUG">
            <appender-ref ref = "CONSOLE"/>
        </root>
    </springProfile>
    <springProfile name = "prod">
        <root level = "INFO">
            <appender-ref ref = "CONSOLE"/>
            <appender-ref ref = "FILE"/>
        </root>
    </springProfile>
</configuration>